<section class="hero hero--compact">
  <div class="wrap hero__split">
    <div>
      <span class="hero__kicker">Hosted by the Centre for Technology and Society</span>
      <h1 style="max-width:18ch;">The Sanjaya Lall Visiting Professorship</h1>
      <p class="hero__lede">
        One of the most prestigious visiting appointments in economics, held by Nobel
        laureates and Clark Medallists, and awarded annually at Oxford since 2011.
      </p>
    </div>
    <figure class="portrait portrait--hero">
      <img src="{{ "/assets/img/sanjaya-lall.jpg" | url }}" alt="Professor Sanjaya Lall" width="820" height="696">
      <figcaption>Professor Sanjaya Lall (1940&ndash;2005)</figcaption>
    </figure>
  </div>
</section>


