---
layout: layouts/base.njk
---
<article class="section">
  <div class="wrap" style="max-width: 820px;">
    <header class="post-header">
      <h1 style="font-size: clamp(1.9rem, 1.4rem + 2vw, 2.8rem);">{{ title }}</h1>
    </header>
    <div class="post-body">{{ content | safe }}</div>
  </div>
</article>
