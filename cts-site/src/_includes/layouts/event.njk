---
layout: layouts/base.njk
---
<article class="section">
  <div class="wrap" style="max-width: 820px;">
    <a class="back-link" href="/events/">&larr; All events</a>
    <header class="post-header">
      <span class="eyebrow">{{ eventType or 'Event' }} &middot; <time datetime="{{ date | isoDate }}">{{ date | longDate }}</time></span>
      <h1 style="font-size: clamp(1.9rem, 1.4rem + 2vw, 2.8rem);">{{ title }}</h1>
      {% if summary %}<p style="font-size:1.1rem; color:var(--slate);">{{ summary }}</p>{% endif %}
      <dl style="display:grid; gap:0.4rem; font-size:0.92rem; color:var(--slate); margin:1.5rem 0 0;">
        {% if time %}<div><strong>Time:</strong> {{ time }}</div>{% endif %}
        {% if location %}<div><strong>Location:</strong> {{ location }}</div>{% endif %}
        {% if speaker %}<div><strong>Speaker:</strong> {{ speaker }}</div>{% endif %}
      </dl>
    </header>
    {% if image %}<img src="{{ image }}" alt="{{ imageAlt or '' }}" style="border-radius:4px; margin-bottom:2.5rem;">{% endif %}
    <div class="post-body">
      {{ content | safe }}
    </div>
    {% if registerLink %}
    <p style="margin-top:2.5rem;"><a class="btn btn--primary" href="{{ registerLink }}">Register to attend &rarr;</a></p>
    {% endif %}
  </div>
</article>
